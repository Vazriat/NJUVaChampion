# 部署配置模板：复制为 .env 并修改（.env 不会提交到 git）
# 生成随机密码：openssl rand -base64 48

# MySQL root 密码（仅容器内部使用，不对外）
DB_ROOT_PASSWORD=change-me

# 业务数据库账号（应用使用这个账号，不用 root 跑业务）
DB_USER=njuvachampion
DB_PASSWORD=change-me

# JWT 签名密钥：Base64 编码，解码后至少 32 字节
# 生成：openssl rand -base64 48
APP_JWT_SECRET=change-me

# 首次启动自动创建管理员 admin 的初始密码（上线后请立即登录修改）
ADMIN_INIT_PASSWORD=change-me
